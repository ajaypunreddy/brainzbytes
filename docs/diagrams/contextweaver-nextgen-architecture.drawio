        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="poc-title" value="Hello World Approval Service - Parallel, Serial, HITL, and MCP Proof of Concept" style="text;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="poc-subtitle" value="One Entra-authenticated request, one immutable plan, a durable live graph, and one cited final result" style="text;strokeColor=none;fillColor=none;fontSize=11;fontColor=#5d7180;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="1500" height="30" as="geometry" /></mxCell>

        <mxCell id="poc-user" value="Entra-authenticated user&#xa;Chat or REST" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="100" width="260" height="80" as="geometry" /></mxCell>
        <mxCell id="poc-request" value="Accept + authorize request&#xa;202 + runId + SSE URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="230" width="280" height="80" as="geometry" /></mxCell>
        <mxCell id="poc-understand" value="1  Understand Request&#xa;typed intent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="360" width="280" height="75" as="geometry" /></mxCell>
        <mxCell id="poc-rag" value="2  Governed RAG&#xa;approved source + citations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="485" width="280" height="80" as="geometry" /></mxCell>

