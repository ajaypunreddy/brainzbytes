        <mxCell id="cea-e1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;endArrow=block;endFill=1;" edge="1" source="cea-login" target="cea-identity" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cea-e2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;endArrow=block;endFill=1;" edge="1" source="cea-identity" target="cea-service" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cea-e3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;endArrow=block;endFill=1;" edge="1" source="cea-service" target="cea-compile" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cea-e4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;endArrow=block;endFill=1;" edge="1" source="cea-compile" target="cea-manifest" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cea-e5" value="evaluate complete graph" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;endArrow=block;endFill=1;" edge="1" source="cea-manifest" target="cea-preflight" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cea-e6" value="authorized plan" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;endArrow=block;endFill=1;" edge="1" source="cea-preflight" target="cea-runtime" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cea-e7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;endArrow=block;endFill=1;" edge="1" source="cea-coordinator" target="cea-runtime-pdp" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cea-e8" value="allow + obligations" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;endArrow=block;endFill=1;" edge="1" source="cea-runtime-pdp" target="cea-token" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cea-e9" value="validate independently" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;endArrow=block;endFill=1;" edge="1" source="cea-token" target="cea-mcp" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cea-e10" value="decision evidence" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" source="cea-runtime-pdp" target="cea-audit" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cea-e11" value="invalidate stale authority" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;endArrow=block;endFill=1;" edge="1" source="cea-revoke" target="cea-runtime-pdp" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cea-e12" value="minimum authorized operation" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;endArrow=block;endFill=1;" edge="1" source="cea-mcp" target="cea-external" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
