      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cea-title" value="ContextWeaver - Request-Time Entitlement and Runtime Authorization" style="text;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1450" height="40" as="geometry" /></mxCell>
        <mxCell id="cea-subtitle" value="Authentication establishes identity. Whole-graph preflight authorizes the plan. Every protected action is reauthorized immediately before use." style="text;strokeColor=none;fillColor=none;fontSize=11;fontColor=#5d7180;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="1500" height="30" as="geometry" /></mxCell>

        <mxCell id="cea-login" value="1  Login&#xa;OIDC + session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="120" width="190" height="75" as="geometry" /></mxCell>
        <mxCell id="cea-identity" value="2  Identity Context&#xa;tenant | principal | groups | roles | purpose | epochs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="280" y="110" width="250" height="95" as="geometry" /></mxCell>
        <mxCell id="cea-service" value="3  Service request&#xa;workflow intent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="570" y="120" width="210" height="75" as="geometry" /></mxCell>
        <mxCell id="cea-compile" value="4  Workflow Compiler&#xa;expand complete reachable graph" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="250" height="95" as="geometry" /></mxCell>
        <mxCell id="cea-manifest" value="5  Authorization Manifest&#xa;required | optional | fallback | compensation | Agent | MCP | RAG | model | disclosure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1110" y="100" width="310" height="115" as="geometry" /></mxCell>

        <mxCell id="cea-preflight" value="REQUEST-TIME PREFLIGHT" style="swimlane;startSize=34;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="100" y="300" width="1400" height="220" as="geometry" /></mxCell>
        <mxCell id="cea-entitlement" value="Entitlement Service&#xa;Service + Workflow + capability eligibility" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf6ec;strokeColor=#82b366;" vertex="1" parent="cea-preflight"><mxGeometry x="60" y="65" width="280" height="70" as="geometry" /></mxCell>
        <mxCell id="cea-pdp" value="Policy Decision Service&#xa;RBAC + ABAC + ReBAC + capability + data + risk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf6ec;strokeColor=#82b366;" vertex="1" parent="cea-preflight"><mxGeometry x="390" y="55" width="310" height="90" as="geometry" /></mxCell>
        <mxCell id="cea-deny" value="Required denial&#xa;reject before dispatch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="cea-preflight"><mxGeometry x="750" y="65" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="cea-plan" value="Authorized Immutable Execution Plan&#xa;hashes | envelopes | decisions | epochs | expiry | fallback sets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="cea-preflight"><mxGeometry x="1040" y="50" width="300" height="100" as="geometry" /></mxCell>

        <mxCell id="cea-runtime" value="RUNTIME PER-ACTION ENFORCEMENT" style="swimlane;startSize=34;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="100" y="600" width="1400" height="250" as="geometry" /></mxCell>
        <mxCell id="cea-coordinator" value="Run Coordinator&#xa;before dispatch | retry | resume | fallback | compensation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3eef6;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="cea-runtime"><mxGeometry x="45" y="65" width="280" height="90" as="geometry" /></mxCell>
        <mxCell id="cea-runtime-pdp" value="Exact action reauthorization&#xa;tool | args | resource | purpose | classification | risk | revocation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="cea-runtime"><mxGeometry x="365" y="55" width="320" height="110" as="geometry" /></mxCell>
        <mxCell id="cea-token" value="Short-lived capability token&#xa;audience + plan + run + node + tool + operation + nonce + expiry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="cea-runtime"><mxGeometry x="725" y="55" width="310" height="110" as="geometry" /></mxCell>
        <mxCell id="cea-mcp" value="MCP / Agent / RAG / Model PEP&#xa;independent validation + schema and resource enforcement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="cea-runtime"><mxGeometry x="1075" y="55" width="280" height="110" as="geometry" /></mxCell>

