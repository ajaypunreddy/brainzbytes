  <diagram id="durable-work-recovery" name="Durable Work Recovery">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1"
      tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1"
      pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="dwr-title" value="ContextWeaver - Durable Cross-Pod Work Recovery" style="text;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry" /></mxCell>
        <mxCell id="dwr-subtitle" value="Kubernetes restores compute. PostgreSQL, RabbitMQ, leases, checkpoints, idempotency, and receipts restore accepted work." style="text;strokeColor=none;fillColor=none;fontSize=11;fontColor=#5d7180;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="1450" height="30" as="geometry" /></mxCell>

        <mxCell id="dwr-request" value="1  Authorized request&#xa;+ idempotency key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="dwr-db" value="2  PostgreSQL transaction&#xa;run + task + outbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="120" width="210" height="70" as="geometry" /></mxCell>
        <mxCell id="dwr-outbox" value="3  Confirmed outbox publisher" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="540" y="120" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="dwr-rmq" value="4  RabbitMQ quorum queue&#xa;manual acknowledgement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="770" y="120" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="dwr-poda" value="5  Worker Pod A&#xa;lease + checkpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1030" y="120" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="dwr-fail" value="Pod / process / node fails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1260" y="120" width="210" height="70" as="geometry" /></mxCell>

        <mxCell id="dwr-podb" value="6  Worker Pod B claims&#xa;redelivery or expired lease" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1030" y="270" width="230" height="70" as="geometry" /></mxCell>
        <mxCell id="dwr-load" value="7  Load pinned plan, checkpoint, inbox, receipts, policy epochs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="730" y="270" width="260" height="70" as="geometry" /></mxCell>
        <mxCell id="dwr-resume" value="8  Resume or safely replay&#xa;idempotent side effects" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="430" y="270" width="250" height="70" as="geometry" /></mxCell>
        <mxCell id="dwr-commit" value="9  Commit result, receipt, audit, next outbox event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="270" width="250" height="70" as="geometry" /></mxCell>

        <mxCell id="dwr-e1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;endArrow=block;endFill=1;" edge="1" source="dwr-request" target="dwr-db" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="dwr-e2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;endArrow=block;endFill=1;" edge="1" source="dwr-db" target="dwr-outbox" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="dwr-e3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;endArrow=block;endFill=1;" edge="1" source="dwr-outbox" target="dwr-rmq" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="dwr-e4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;endArrow=block;endFill=1;" edge="1" source="dwr-rmq" target="dwr-poda" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="dwr-e5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;endArrow=block;endFill=1;" edge="1" source="dwr-poda" target="dwr-fail" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="dwr-e6" value="redeliver / reclaim" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;endArrow=block;endFill=1;" edge="1" source="dwr-fail" target="dwr-podb" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="dwr-e7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;endArrow=block;endFill=1;" edge="1" source="dwr-podb" target="dwr-load" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="dwr-e8" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;endArrow=block;endFill=1;" edge="1" source="dwr-load" target="dwr-resume" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="dwr-e9" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;endArrow=block;endFill=1;" edge="1" source="dwr-resume" target="dwr-commit" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="dwr-data" value="Authoritative durable state" style="swimlane;startSize=34;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="410" width="700" height="220" as="geometry" /></mxCell>
        <mxCell id="dwr-data1" value="Runs | tasks | attempts | dependencies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf4fc;strokeColor=#6c8ebf;" vertex="1" parent="dwr-data"><mxGeometry x="40" y="55" width="280" height="45" as="geometry" /></mxCell>
        <mxCell id="dwr-data2" value="Leases | heartbeats | timers | HITL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf4fc;strokeColor=#6c8ebf;" vertex="1" parent="dwr-data"><mxGeometry x="370" y="55" width="280" height="45" as="geometry" /></mxCell>
        <mxCell id="dwr-data3" value="Inbox | outbox | checkpoints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf4fc;strokeColor=#6c8ebf;" vertex="1" parent="dwr-data"><mxGeometry x="40" y="125" width="280" height="45" as="geometry" /></mxCell>
        <mxCell id="dwr-data4" value="Receipts | Saga | compensation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf4fc;strokeColor=#6c8ebf;" vertex="1" parent="dwr-data"><mxGeometry x="370" y="125" width="280" height="45" as="geometry" /></mxCell>

        <mxCell id="dwr-k8s" value="Kubernetes availability profile" style="swimlane;startSize=34;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="810" y="410" width="700" height="220" as="geometry" /></mxCell>
        <mxCell id="dwr-k8s1" value="2+ replicas | topology spread | PDB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf6ec;strokeColor=#82b366;" vertex="1" parent="dwr-k8s"><mxGeometry x="40" y="55" width="280" height="45" as="geometry" /></mxCell>
        <mxCell id="dwr-k8s2" value="maxUnavailable 0 | maxSurge 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf6ec;strokeColor=#82b366;" vertex="1" parent="dwr-k8s"><mxGeometry x="370" y="55" width="280" height="45" as="geometry" /></mxCell>
        <mxCell id="dwr-k8s3" value="startup | readiness | liveness" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf6ec;strokeColor=#82b366;" vertex="1" parent="dwr-k8s"><mxGeometry x="40" y="125" width="280" height="45" as="geometry" /></mxCell>
        <mxCell id="dwr-k8s4" value="graceful drain | HPA | KEDA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf6ec;strokeColor=#82b366;" vertex="1" parent="dwr-k8s"><mxGeometry x="370" y="125" width="280" height="45" as="geometry" /></mxCell>

        <mxCell id="dwr-note" value="Availability is not durability: replicas keep endpoints reachable; durable state and idempotent recovery prevent accepted work from being lost or applied twice." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180" y="690" width="1240" height="58" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="credential-non-possession" name="Credential Non-Possession">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1"
      tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1"
      pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cnp-title" value="ContextWeaver - Credential Non-Possession and Delegated Authority" style="text;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell>
        <mxCell id="cnp-subtitle" value="Agents receive constrained workload identity and opaque references; trusted gateways resolve short-lived credentials and never export them." style="text;strokeColor=none;fillColor=none;fontSize=11;fontColor=#5d7180;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="1450" height="30" as="geometry" /></mxCell>

        <mxCell id="cnp-user" value="Human authentication&#xa;server-side session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="130" width="230" height="70" as="geometry" /></mxCell>
        <mxCell id="cnp-policy" value="Identity + Entitlement + Policy&#xa;delegation and consent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="130" width="260" height="70" as="geometry" /></mxCell>
        <mxCell id="cnp-plan" value="Immutable plan / message&#xa;references only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="690" y="130" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="cnp-agent" value="Agent sandbox&#xa;narrow workload identity&#xa;NO credential values" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="990" y="105" width="260" height="120" as="geometry" /></mxCell>
        <mxCell id="cnp-rmq" value="RabbitMQ&#xa;typed request / result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1320" y="130" width="210" height="70" as="geometry" /></mxCell>

        <mxCell id="cnp-gateway" value="Trusted enforcement gateways" style="swimlane;startSize=34;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="310" width="760" height="230" as="geometry" /></mxCell>
        <mxCell id="cnp-mcp" value="MCP / Connector Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf6ec;strokeColor=#82b366;" vertex="1" parent="cnp-gateway"><mxGeometry x="45" y="55" width="300" height="48" as="geometry" /></mxCell>
        <mxCell id="cnp-model" value="Model Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf6ec;strokeColor=#82b366;" vertex="1" parent="cnp-gateway"><mxGeometry x="415" y="55" width="300" height="48" as="geometry" /></mxCell>
        <mxCell id="cnp-data" value="Data / RAG Connector Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf6ec;strokeColor=#82b366;" vertex="1" parent="cnp-gateway"><mxGeometry x="45" y="135" width="300" height="48" as="geometry" /></mxCell>
        <mxCell id="cnp-token" value="Workload identity / OBO / token exchange" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="cnp-gateway"><mxGeometry x="415" y="135" width="300" height="48" as="geometry" /></mxCell>

        <mxCell id="cnp-secrets" value="Secrets broker / cloud identity&#xa;credential values stay here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="640" width="280" height="80" as="geometry" /></mxCell>
        <mxCell id="cnp-external" value="Approved external resource&#xa;exact audience + operation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="490" y="640" width="280" height="80" as="geometry" /></mxCell>
        <mxCell id="cnp-evidence" value="Privacy-safe audit evidence&#xa;references, decisions, expiry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="860" y="640" width="280" height="80" as="geometry" /></mxCell>
        <mxCell id="cnp-denied" value="DENIED FROM AGENT&#xa;secret mounts | user tokens | provider keys | Vault | metadata | database | object store | MCP endpoints | public internet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1230" y="600" width="300" height="160" as="geometry" /></mxCell>

        <mxCell id="cnp-e1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;endArrow=block;endFill=1;" edge="1" source="cnp-user" target="cnp-policy" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cnp-e2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;endArrow=block;endFill=1;" edge="1" source="cnp-policy" target="cnp-plan" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cnp-e3" value="refs only" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;endArrow=block;endFill=1;" edge="1" source="cnp-plan" target="cnp-agent" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cnp-e4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;endArrow=block;endFill=1;" edge="1" source="cnp-agent" target="cnp-rmq" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cnp-e5" value="typed request" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;endArrow=block;endFill=1;" edge="1" source="cnp-rmq" target="cnp-gateway" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cnp-e6" value="resolve JIT" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;endArrow=block;endFill=1;" edge="1" source="cnp-secrets" target="cnp-token" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cnp-e7" value="scoped call" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;endArrow=block;endFill=1;" edge="1" source="cnp-gateway" target="cnp-external" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cnp-e8" value="decision metadata" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;endArrow=block;endFill=1;" edge="1" source="cnp-gateway" target="cnp-evidence" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="cnp-note" value="A credential reference is not authority. Resolution requires current workload identity, policy, delegation, consent, resource, audience, purpose, expiry, and revocation checks." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180" y="820" width="1240" height="58" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="dynamic-capability-lifecycle" name="Dynamic Agent and MCP Lifecycle">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1"
      tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1"
      pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="dcl-title" value="ContextWeaver - Dynamic Agent and MCP Admission, Deployment, and Discovery" style="text;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="40" as="geometry" /></mxCell>
        <mxCell id="dcl-subtitle" value="Dynamic onboarding never means direct deployment: every package is validated, scanned, approved, reconciled by the Capability Operator, and verified by the Registry." style="text;strokeColor=none;fillColor=none;fontSize=11;fontColor=#5d7180;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="1500" height="30" as="geometry" /></mxCell>

        <mxCell id="dcl-submit" value="1  UI / API / Git submission&#xa;AgentSpec or MCPSpec" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="120" width="220" height="75" as="geometry" /></mxCell>
        <mxCell id="dcl-normalize" value="2  Parse + normalize&#xa;strict schemas + digest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="310" y="120" width="220" height="75" as="geometry" /></mxCell>
        <mxCell id="dcl-scan" value="3  Supply-chain scans&#xa;signature | SBOM | CVE | malware | secrets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="570" y="110" width="250" height="95" as="geometry" /></mxCell>
        <mxCell id="dcl-eval" value="4  Security + quality + resilience evaluation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="860" y="120" width="250" height="75" as="geometry" /></mxCell>
        <mxCell id="dcl-approve" value="5  Risk approval&#xa;signed immutable release bundle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1150" y="120" width="250" height="75" as="geometry" /></mxCell>

        <mxCell id="dcl-operator" value="6  Capability Operator" style="swimlane;startSize=34;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="190" y="300" width="1220" height="230" as="geometry" /></mxCell>
        <mxCell id="dcl-verify" value="Reverify signatures, evidence, image and chart digests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3eef6;strokeColor=#9673a6;" vertex="1" parent="dcl-operator"><mxGeometry x="45" y="55" width="250" height="50" as="geometry" /></mxCell>
        <mxCell id="dcl-helm" value="Render allowlisted Helm package" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3eef6;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="dcl-operator"><mxGeometry x="335" y="55" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="dcl-policy" value="Apply identity, queues, security, network, quota, PDB, HPA/KEDA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3eef6;strokeColor=#9673a6;" vertex="1" parent="dcl-operator"><mxGeometry x="615" y="50" width="270" height="60" as="geometry" /></mxCell>
        <mxCell id="dcl-reconcile" value="Reconcile, status, drift, drain, rollback, quarantine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3eef6;strokeColor=#9673a6;" vertex="1" parent="dcl-operator"><mxGeometry x="925" y="55" width="250" height="50" as="geometry" /></mxCell>
        <mxCell id="dcl-agentns" value="Agent runtime namespace&#xa;RabbitMQ + Model Gateway only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="dcl-operator"><mxGeometry x="260" y="140" width="300" height="55" as="geometry" /></mxCell>
        <mxCell id="dcl-mcpns" value="MCP runtime namespace&#xa;RabbitMQ + approved connector domain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="dcl-operator"><mxGeometry x="660" y="140" width="320" height="55" as="geometry" /></mxCell>

        <mxCell id="dcl-discover" value="7  Runtime discovery" style="swimlane;startSize=34;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="80" y="610" width="1440" height="190" as="geometry" /></mxCell>
        <mxCell id="dcl-contracts" value="Service descriptor + Agent Card / MCP capabilities + schemas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf6ec;strokeColor=#82b366;" vertex="1" parent="dcl-discover"><mxGeometry x="45" y="60" width="300" height="55" as="geometry" /></mxCell>
        <mxCell id="dcl-ops" value="Health + capacity + metrics + dashboards + alerts + runbook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf6ec;strokeColor=#82b366;" vertex="1" parent="dcl-discover"><mxGeometry x="390" y="60" width="300" height="55" as="geometry" /></mxCell>
        <mxCell id="dcl-registry" value="Registry validation&#xa;candidate lifecycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="dcl-discover"><mxGeometry x="735" y="60" width="280" height="55" as="geometry" /></mxCell>
        <mxCell id="dcl-promote" value="Synthetic + canary evidence&#xa;logical alias promotion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="dcl-discover"><mxGeometry x="1060" y="60" width="300" height="55" as="geometry" /></mxCell>

        <mxCell id="dcl-e1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;endArrow=block;endFill=1;" edge="1" source="dcl-submit" target="dcl-normalize" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="dcl-e2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;endArrow=block;endFill=1;" edge="1" source="dcl-normalize" target="dcl-scan" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="dcl-e3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;endArrow=block;endFill=1;" edge="1" source="dcl-scan" target="dcl-eval" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
